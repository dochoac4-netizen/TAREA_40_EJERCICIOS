# Ej. 16 MEDIO  Codificador/Decodificador

# Clase CodificadorCesar que: (1) tenga método codificar_letra(letra, desplazamiento) que retorne la letra desplazada en el alfabeto (usar operador %); (2) tenga método codificar_palabra(palabra, desplazamiento) que reutilice el anterior para toda la palabra; (3) tenga un diccionario como atributo para historial de codificaciones.

# ENTRADA
# letra/palabra y desplazamiento (1-25)

# PROCESO
# convertir a código ASCII, desplazar con %, guardar historial

# SALIDA
# palabra codificada

# EJEMPLO DE ENTRADA
# cc = CodificadorCesar()
# cc.codificar_palabra("hola", 3)

# SALIDA ESPERADA
# "krod" (Nota: "hola" con desplazamiento +3 genera "krod")

# Colecciones: diccionario para historial; ord() y chr() para conversión


class CodificadorCesar:

    def __init__(self):
        self.historial = {}

    def codificar_letra(self, letra, desplazamiento):
        if 'a' <= letra <= 'z':
            base = ord('a')
            nuevo_codigo = (ord(letra) - base + desplazamiento) % 26 + base
            return chr(nuevo_codigo)
        elif 'A' <= letra <= 'Z':
            base = ord('A')
            nuevo_codigo = (ord(letra) - base + desplazamiento) % 26 + base
            return chr(nuevo_codigo)
        return letra

    def codificar_palabra(self, palabra, desplazamiento):
        resultado = []
        for caracter in palabra:
            letra_codificada = self.codificar_letra(caracter, desplazamiento)
            resultado.append(letra_codificada)

        palabra_codificada = "".join(resultado)
        self.historial[palabra] = palabra_codificada
        return palabra_codificada

# DEPURACIÓN / PRUEBA DE ESCRITORIO
# cc = CodificadorCesar() -> self.historial = {}

# 1. Probar codificar_letra:
# cc.codificar_letra('h', 3)
# -> base = ord('a') = 97
# -> ord('h') = 104
# -> (104 - 97 + 3) % 26 + 97 = 10 % 26 + 97 = 107
# -> chr(107) = 'k'

# 2. Probar codificar_palabra:
# cc.codificar_palabra("hola", 3)
# -> 'h' -> 'k'
# -> 'o' -> 'r'
# -> 'l' -> 'o'
# -> 'a' -> 'd'
# -> palabra_codificada = "krod"
# -> self.historial["hola"] = "krod"
# -> Retorna: "krod"

