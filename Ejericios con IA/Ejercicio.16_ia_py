# 1. ENTENDER EL PROBLEMA
# ENTRADA: dígito/número en texto y desplazamiento clave (1-9)
# PROCESO: convertir a código ASCII, desplazar dígito con %, guardar historial
# SALIDA: número codificado en texto
# EJEMPLO DE ENTRADA:
# en = EncriptadorNumerico()
# en.codificar_numero("981", 3)
# SALIDA ESPERADA:
# "214"


# 2. BOSQUEJO
# codificar_digito('9', 3):
#   ord('9') -> 57
#   código relativo a '0' (48): 57 - 48 = 9
#   desplazamiento con módulo: (9 + 3) % 10 = 2
#   volver a ASCII: 2 + 48 = 50 -> chr(50) -> '2'
#
# codificar_numero("981", 3):
#   '9' + 3 -> '2'
#   '8' + 3 -> '1'
#   '1' + 3 -> '4'
#   Guarda en historial: {"981": "214"}
#   Retorna: "214"


# 3. PATRÓN
# Colecciones: diccionario para historial; ord() y chr() para conversión


# 4. CÓDIGO
class EncriptadorNumerico:

    def __init__(self):
        self.historial = {}

    def codificar_digito(self, digito, desplazamiento):
        if '0' <= digito <= '9':
            base = ord('0')
            nuevo_codigo = (ord(digito) - base + desplazamiento) % 10 + base
            return chr(nuevo_codigo)
        return digito

    def codificar_numero(self, numero_texto, desplazamiento):
        resultado = []
        for digito in numero_texto:
            resultado.append(self.codificar_digito(digito, desplazamiento))

        numero_codificado = "".join(resultado)
        self.historial[numero_texto] = numero_codificado
        return numero_codificado

# 5. PRUEBA / DEPURACIÓN DETALLADA
en = EncriptadorNumerico()

# --- Prueba Método 1: codificar_digito('8', 3) ---
salida1 = en.codificar_digito('8', 3)
print("Salida 1:", salida1)

# --- Prueba Método 2: codificar_numero("981", 3) ---
salida2 = en.codificar_numero("981", 3)
print("Salida 2:", salida2)

# --- Prueba Historial ---
print("Historial:", en.historial)